{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": [
    {
      "site": "rencontre-animal",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**/*.m3u",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/vnd.apple.mpegurl"
            }
          ]
        }
      ]
    },
    {
      "site": "arsenkubat",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/channels.m3u",
          "destination": "/Arsen.m3u"
        }
      ],
      "headers": [
        {
          "source": "**/*.m3u",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/vnd.apple.mpegurl"
            }
          ]
        }
      ]
    }
  ]
}
