rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /conversations/{matchId}/photos/{fileName} {
      allow read: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(matchId)).data.userIds;

      allow write: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(matchId)).data.userIds
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
